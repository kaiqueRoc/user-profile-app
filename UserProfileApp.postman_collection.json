    {
      "name": "Users",
      "item": [
        { "name": "Search Users", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/users?query={{searchQuery}}", "host": ["{{baseUrl}}"], "path": ["api","users"], "query": [ { "key": "query", "value": "{{searchQuery}}" } ] } } }
      ]
    }
  ]
